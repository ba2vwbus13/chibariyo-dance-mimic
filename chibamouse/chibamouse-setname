#!/bin/bash
# 専攻科実験のイメージを複製した SD カードを、研究用のロボット（chibamouse1 など）に作り変える。
# 専攻科実験の pimouse-setname（授業/13専攻科実験/2026/_scripts/）を元に、名前を自由に付けられるようにし、
# ROS_DOMAIN_ID（研究用は 30）を ~/.bashrc に書くようにした。
#   使い方: sudo chibamouse-setname <名前> [ROS_DOMAIN_ID]　（例: sudo chibamouse-setname chibamouse1 30）
#   終わったら sudo poweroff → 緑の LED が消えてから電源を切り、入れ直す（reboot は使わない）
# Raspberry Pi に直接つないだ画面（TERM=linux）は日本語を表示できないので、そのときは英語で表示する。
set -e
say() { if [ "${TERM:-}" = linux ]; then echo "$2"; else echo "$1"; fi; }
[ "$(id -u)" = 0 ] || { say "sudo を付けて実行してください（例: sudo chibamouse-setname chibamouse1）" "Run with sudo (e.g. sudo chibamouse-setname mymouse1 45)"; exit 1; }
name="$1"
domain="${2:-30}"
[[ "$name" =~ ^[a-z][a-z0-9-]{0,30}$ ]] || { say "使い方: sudo chibamouse-setname <名前（英小文字・数字・-）> [ROS_DOMAIN_ID]" "Usage: sudo chibamouse-setname <name (a-z, 0-9, -)> [ROS_DOMAIN_ID]"; exit 1; }
[[ "$domain" =~ ^[0-9]+$ ]] && [ "$((10#$domain))" -le 101 ] || { say "ROS_DOMAIN_ID は 0〜101 の数字にしてください" "ROS_DOMAIN_ID must be a number from 0 to 101"; exit 1; }
# 先頭の 0 を取る。ROS 2 は 09 を受け付けず、010 を 8 進数（8）と読むため
domain=$((10#$domain))

# 名前（cloud-init が起動のたびに user-data の hostname を使うので、そちらも書き換える）
hostnamectl set-hostname "$name"
sed -i -E "s/^127\.0\.1\.1[[:space:]].*/127.0.1.1 $name $name/" /etc/hosts
sed -i -E "s/^hostname:.*/hostname: $name/" /boot/firmware/user-data

# machine-id を作り直す（/var/lib/dbus/machine-id は /etc/machine-id へのリンク）
rm -f /etc/machine-id
systemd-machine-id-setup >/dev/null
# 古い machine-id のジャーナルのフォルダは消さない。動いている journald がまだ書き込んでいるので、消すと
# 「Failed to create new system journal」が画面に出る。電源を入れ直すと新しいフォルダに書くようになる

# SSH のホスト鍵を作り直す
rm -f /etc/ssh/ssh_host_*
ssh-keygen -A >/dev/null

# ROS_DOMAIN_ID（研究用のロボットは決まった人しか使わないので、ログインのたびに自動で設定する）
bashrc=/home/ubuntu/.bashrc
sed -i '/^export ROS_DOMAIN_ID=/d' "$bashrc"
echo "export ROS_DOMAIN_ID=$domain" >> "$bashrc"

# ログインしたときの表示に、名前と ROS_DOMAIN_ID を出す（画面で読めるよう英語で書く）
sed -i '/^This robot: /d' /etc/motd 2>/dev/null || true
echo "This robot: $name  ROS_DOMAIN_ID=$domain" >> /etc/motd

# パーティションがカードいっぱいに広がっていなければ広げる（通常は cloud-init が起動時に広げている）
growpart /dev/mmcblk0 2 >/dev/null 2>&1 && resize2fs /dev/mmcblk0p2 >/dev/null 2>&1 || true

say "$name に作り変えました。" "Renamed to $name."
echo "  machine-id: $(cat /etc/machine-id)"
say "  ROS_DOMAIN_ID: $domain（~/.bashrc）" "  ROS_DOMAIN_ID: $domain (~/.bashrc)"
say "  wlan0 の MAC アドレス: $(cat /sys/class/net/wlan0/address)（ルータの DHCP リースに登録する）" "  wlan0 MAC address: $(cat /sys/class/net/wlan0/address)"
say "  容量: $(df -h / | awk 'NR==2{print $2}')" "  Disk: $(df -h / | awk 'NR==2{print $2}')"
say "次に sudo poweroff を実行し、緑の LED が消えてから電源を切って、入れ直してください（reboot は使わない）。" \
    "Next: sudo poweroff, wait until the green LED is off, then switch the power off and on (do not use reboot)."
